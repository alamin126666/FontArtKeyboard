<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FontsArtKeyboard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.FontsArtKeyboard.SplashTheme" parent="Theme.SplashScreen">
